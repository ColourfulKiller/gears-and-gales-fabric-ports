{
  "schemaVersion": 1,
  "id": "blockui",
  "version": "${version}",
  "name": "BlockUI (Fabric port)",
  "description": "UI library mod, ported from LDT Team's NeoForge BlockUI. Use ctrl+alt+shift+x to open a test UI.",
  "authors": ["LDT Team"],
  "contributors": ["Fabric port: tyler"],
  "contact": { "sources": "https://github.com/ldtteam/BlockUI" },
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": ["com.ldtteam.blockui.mod.BlockUI"],
    "client": ["com.ldtteam.blockui.mod.BlockUIClient"]
  },
  "accessWidener": "blockui.accesswidener",
  "mixins": ["blockui.mixins.json", "ldtteam_events.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": "*"
  }
}
