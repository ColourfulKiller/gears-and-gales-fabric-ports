{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "type",
    "cases": [
      {
        "when": "plain",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/post/post_plain_spec"
        }
      },
      {
        "when": "heavy",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/post/post_heavy_spec"
        }
      },
      {
        "when": "turned",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/post/post_turned_spec"
        }
      },
      {
        "when": "pinched",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/post/post_pinched_spec"
        }
      },
      {
        "when": "double",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/post/post_double_spec"
        }
      },
      {
        "when": "quad",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/post/post_quad_spec"
        }
      }
    ],
    "fallback": {
      "type": "domum_ornamentum:materially_textured",
      "model": "domum_ornamentum:block/post/post_plain_spec"
    }
  }
}
