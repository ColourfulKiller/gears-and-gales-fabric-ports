{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "type",
    "cases": [
      {
        "when": "full",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/trapdoor/fancy/trapdoor_full_spec"
        }
      },
      {
        "when": "creeper",
        "model": {
          "type": "domum_ornamentum:materially_textured",
          "model": "domum_ornamentum:block/trapdoor/fancy/trapdoor_creeper_spec"
        }
      }
    ],
    "fallback": {
      "type": "domum_ornamentum:materially_textured",
      "model": "domum_ornamentum:block/trapdoor/fancy/trapdoor_full_spec"
    }
  }
}
